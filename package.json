{
  "name": "mozart",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "personas:tastes": "tsx scripts/persona-tastes.ts",
    "shots": "tsx scripts/shots.ts",
    "shots:diff": "tsx scripts/shots-diff.ts",
    "test:e2e": "playwright test",
    "test:unit": "tsx --conditions=react-server --test tests/unit/*.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "iron-session": "^9.0.1",
    "nanoid": "^6.0.2",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.5.2"
