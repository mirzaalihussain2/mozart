# Postgres (Supabase). Use the transaction pooler URL (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Optional: direct/session URL (port 5432) used only by `pnpm db:migrate`
# if migrations hang on the transaction pooler. Defaults to DATABASE_URL.
# DATABASE_URL_MIGRATE=

# Cookie encryption key for iron-session, 32+ characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# The app's public origin, used for share links, Open Graph tags and the
# Spotify redirect (lib/server/app-url.ts). Always 127.0.0.1 locally, never
# localhost (Spotify redirect URIs + cookies).
# On Vercel: set APP_URL for Production only (your production domain, e.g.
# https://mozart.example.com). Leave it unset for Preview; previews use
# https://$VERCEL_URL automatically.
APP_URL=http://127.0.0.1:3000

# Spotify app credentials (server only, never NEXT_PUBLIC_). Without them,
# "Connect Spotify" silently signs in a demo user (Candice). Register these redirect
# URIs in the Spotify dashboard: http://127.0.0.1:3000/auth/spotify/callback
# and {production APP_URL}/auth/spotify/callback (previews always use the
# demo-user fallback). scripts/persona-tastes.ts (pnpm personas:tastes) also
# uses them, to look up Derek's and Candice's songs.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Tests only: point at a fake Spotify (ignored when VERCEL_ENV=production).
# SPOTIFY_ACCOUNTS_URL=http://127.0.0.1:4545
# SPOTIFY_API_URL=http://127.0.0.1:4545

# Supabase Storage for generated album art (server only, never NEXT_PUBLIC_).
# The project's base URL (Project Settings → Data API → Project URL), without
# /rest/v1, and a secret key (sb_secret_…). Images go in a public bucket named
# `artwork` (images only); each one gets its own file name, because the CDN
# keeps serving a replaced or deleted file for a while.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
